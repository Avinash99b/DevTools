PORT=3000
ACCESS_SECRET=your_secure_password_here
CORS_ORIGIN=http://localhost:5173
PERSISTENT_FILE_SIZE_MAX=10485760
TOTAL_STORAGE_CAP_MB=1024
DB_PATH=./data/devtools.db
STORAGE_PATH=./data/storage
# Session lifetime in milliseconds (default 24 hours)
SESSION_TTL_MS=86400000
# Login rate limiting
LOGIN_WINDOW_MS=60000
LOGIN_MAX_ATTEMPTS=10
# Max characters accepted by the token estimator
MAX_TOKEN_TEXT_CHARS=200000